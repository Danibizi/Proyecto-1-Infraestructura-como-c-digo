[servidores_web]
web ansible_host=${ip_web} ansible_user=debian
web2 ansible_host=${ip_web2} ansible_user=debian

[servidores_bd]
bd ansible_host=${ip_bd} ansible_user=ubuntu

[servidores_nas]
nas ansible_host=${ip_nas} ansible_user=debian

[servidores_balanceador]
balanceador ansible_host=${ip_balanceador} ansible_user=debian
